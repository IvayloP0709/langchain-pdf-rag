# Copy to .env and fill in values.
# Never commit .env.

# Required for LLM calls
OPENAI_API_KEY=sk-...

# Embedding provider: openai or local
EMBEDDING_PROVIDER=openai

# If EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# If EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional: improves HF download rate limits for local models
HF_TOKEN=hf_...
# Optional alias (used by some libraries)
HUGGINGFACEHUB_API_TOKEN=hf_...
# true = hide most HF/transformers startup noise
HF_QUIET=true

# Vector store: Qdrant. Local dev points at a local Docker container by
# default (see docs/decisions.md for why) — the deployed environment reads
# these from SSM Parameter Store instead of this file, see
# docs/runbooks/qdrant-cloud-provisioning.md.
# Start the local container with:
#   docker run -p 6333:6333 -v $(pwd)/qdrant_storage:/qdrant/storage qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=local-dev-unused
QDRANT_COLLECTION=rag_documents

# Provisioning-only, temporary: paste the values from the Qdrant Cloud
# console here so scripts/provision_qdrant_cloud.sh can pick them up. Not
# read by the app itself. Delete both lines once the script has run once —
# see docs/runbooks/qdrant-cloud-provisioning.md.
QDRANT_CLOUD_URL=
QDRANT_CLOUD_API_KEY=

# Retrieval tuning
RETRIEVAL_K=3
DOC_PREVIEW_CHARS=800

# Reranking: none / pretrained / finetuned
RERANKER_MODE=none
# Candidate pool size fetched before reranking (independent of RETRIEVAL_K)
RERANK_CANDIDATE_K=15
# Only consulted when RERANKER_MODE=finetuned
RERANKER_MODEL_PATH=models/reranker/finetuned

# Optional observability (not required by runtime)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls_...
LANGCHAIN_PROJECT=langchain-pdf-rag


# optinional: debug timing for CLI commands (not needed in production)
CLI_DEBUG_TIMING=false

# API base URL
API_BASE_URL=http://localhost:8000